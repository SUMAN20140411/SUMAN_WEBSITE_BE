HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Strapi DB: when false, auto schema sync will NOT drop columns/tables (safer on production / after media→Cloudinary changes).
# Default is false when NODE_ENV=production, true otherwise. Set explicitly if needed:
# DATABASE_FORCE_MIGRATION=false
# DATABASE_RUN_MIGRATIONS=true

# Test request mail. Leave SMTP_HOST empty locally to log the requester email instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=
SMTP_DEFAULT_REPLY_TO=

# Origin used for the progress link in the requester email. No path.
PUBLIC_SITE_URL=http://localhost:3000

# Filled in later. Manager notification is skipped until this address is set.
TEST_CENTER_MANAGER_EMAIL=

# Optional origin of this Strapi admin, linked from the manager email.
# STRAPI_PUBLIC_URL=http://localhost:1337

# Frontend: NEXT_PUBLIC_TEST_INTAKE_API_URL=http://localhost:1337/api/test-requests/intake
# Frontend: NEXT_PUBLIC_TEST_STATUS_API_URL=http://localhost:1337/api/test-requests/status
